# Database
DATABASE_URL="postgresql://heredia:heredia_dev@localhost:5432/heredia"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-in-production-min-32-chars!!"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET="heredia-docs"
S3_REGION="us-east-1"

# Email (SMTP)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@heredia.app"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Stripe Price IDs — subscripcion mensual + anual por plan
STRIPE_PRICE_INICIA_MONTHLY="price_xxx"
STRIPE_PRICE_INICIA_ANNUAL="price_xxx"
STRIPE_PRICE_DESPACHO_MONTHLY="price_xxx"
STRIPE_PRICE_DESPACHO_ANNUAL="price_xxx"
STRIPE_PRICE_FIRMA_MONTHLY="price_xxx"
STRIPE_PRICE_FIRMA_ANNUAL="price_xxx"

# Stripe Price IDs — setup fees one-off (Inicia no usa setup)
STRIPE_PRICE_SETUP_DESPACHO="price_xxx"
STRIPE_PRICE_SETUP_FIRMA="price_xxx"

# Anthropic (IA Autopilot) — leave empty for stub mode
ANTHROPIC_API_KEY=""

# App
APP_URL="http://localhost:3000"

# Crons (Vercel Cron) — secret compartido para autorizar disparos
CRON_SECRET=""

# Demo publica (true habilita /login?demo=1 y el cron de reseteo diario)
DEMO_ENABLED="false"

# Notificacion de nuevos leads (digest de stale-leads se envia aqui)
LEADS_NOTIFY_EMAIL=""

# Superadmin whitelist — emails del equipo Heredia separados por comas.
# Solo estos pueden acceder a /admin/metrics, /admin/funnel,
# /admin/demo-requests y dar trials desde /api/admin/orgs/[id]/trial.
# Vacio = panel admin inaccesible (fail-closed).
ADMIN_EMAILS=""

# Google SSO (opcional, plan Firma). Cuando ambas están definidas, /login
# muestra "Continuar con Google". GOOGLE_WORKSPACE_HD opcional restringe
# el dominio del Workspace al iniciar sesión.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_WORKSPACE_HD=""

# Cifrado de secretos guardados en base de datos (webhook HMAC del cliente).
# 32 bytes en base64 o hex. Independiente de NEXTAUTH_SECRET a proposito.
#   openssl rand -base64 32
# Sin esta variable, guardar un secreto de webhook se rechaza (no se guarda en claro).
SECRETS_ENCRYPTION_KEY=""

# Tamano maximo por archivo subido, en MB. Por defecto 20, tope duro 200.
MAX_UPLOAD_MB="20"

# Retencion de los registros de IA (PromptLog), en dias. Por defecto 90.
PROMPT_LOG_RETENTION_DAYS="90"

# Avisos operativos de alta prioridad (fase 10).
#
# Destino de los avisos que exigen intervencion humana:
#   - eventos de Stripe que agotan los reintentos automaticos y pueden
#     corresponder a cobros ya realizados sin aplicar;
#   - purgas de retencion bloqueadas, cuyos datos personales siguen
#     almacenados pese a haber vencido el plazo.
#
# Si no se define, se cae a LEADS_NOTIFY_EMAIL y, en su defecto, el aviso solo
# queda en los logs del servidor.
OPS_ALERT_EMAIL=""

# ─────────────────────────────────────────────────────────────────────────────
# Datos legales de la entidad responsable (RGPD art. 13 / LSSI art. 10)
#
# OBLIGATORIAS EN PRODUCTION. `scripts/check-legal-config.mjs` detiene el build
# si falta cualquiera de las cuatro cuando VERCEL_ENV=production (o
# DEPLOY_TARGET=production). En desarrollo y en Preview solo avisa, y los textos
# muestran "[Entidad responsable pendiente de constituir e inscribir]".
#
# NO las rellenes con datos provisionales ni inventados: mientras la sociedad no
# este constituida e inscrita, lo correcto es no desplegar a produccion.
LEGAL_ENTITY_NAME=""      # Denominacion social completa, tal como figure en el Registro Mercantil
LEGAL_ENTITY_NIF=""       # NIF de la entidad
LEGAL_ENTITY_ADDRESS=""   # Domicilio social completo
LEGAL_PRIVACY_EMAIL=""    # Direccion para el ejercicio de derechos (acceso, rectificacion, supresion...)

# OPCIONAL. Designar delegado de proteccion de datos solo es obligatorio en los
# supuestos del articulo 37 del RGPD; afirmar que existe uno cuando no lo hay
# seria una invencion, asi que se deja vacia salvo que se haya designado.
LEGAL_DPO_CONTACT=""
