generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  OPERATOR
  VIEWER
  MANAGED_OPS
}

enum CaseStatus {
  INTAKE
  VALIDATION
  IN_PROGRESS
  PENDING_DOCS
  READY_TO_SEND
  SENT
  FOLLOW_UP
  CLOSED
  ARCHIVED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  READY
  APPROVED
  DONE
  SKIPPED
}

enum TaskCategory {
  BANCOS
  SUMINISTROS
  TELECOM
  SUSCRIPCIONES
  SEGUROS
  VIDA_DIGITAL
  FISCAL
  OTROS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanTier {
  INICIA
  DESPACHO
  FIRMA
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

// ─── ORGANIZATION ────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       Membership[]
  cases         Case[]
  templates     Template[]
  subscription  Subscription?
  usageRecords  UsageRecord[]
  auditLogs     AuditLog[]
  demoRequests  DemoRequest[]
  notifications NotificationLog[]
  workflowRules WorkflowRule[]
  caseTemplates CaseTemplate[]
  purgeEvidence PurgeEvidence[]
  caseCounters  CaseCounter[]

  retentionDays Int @default(90)

  // White-label del portal familia. Unlocked en plan DESPACHO/FIRMA
  // (INICIA sigue mostrando "Powered by Heredia").
  brandDisplayName  String?
  brandLogoUrl      String?
  brandPrimaryColor String? // hex, e.g. "#1e40af"
  brandSupportEmail String?
  brandFooterText   String?

  // Integraciones de notificación outbound (Plan Firma).
  // - slackWebhookUrl: incoming webhook de Slack (https://hooks.slack.com/...)
  // - customWebhookUrl: endpoint del cliente que recibe los eventos en JSON
  // - customWebhookSecret: secreto HMAC-SHA256 que firma el payload en X-HEREDIA-Signature
  slackWebhookUrl     String?
  teamsWebhookUrl     String?
  customWebhookUrl    String?
  customWebhookSecret String?

  // Onboarding guiado. Se oculta al marcarse dismiss o al completar los 5 pasos.
  onboardingDismissedAt DateTime?

  /// Uso de IA con proveedor externo (Anthropic). DESACTIVADO por defecto:
  /// enviar datos de un expediente a un tercero es una decision del
  /// responsable del tratamiento — la gestoria o funeraria —, no del
  /// proveedor del software. Antes se hacia sin que nadie lo decidiera.
  aiEnabled   Boolean   @default(false)
  aiEnabledAt DateTime?
}

// ─── USER & MEMBERSHIP ──────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  magicToken    String?
  magicTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   Membership[]
  assignedTasks Task[]       @relation("AssignedTo")
  approvals     Approval[]
  auditLogs     AuditLog[]
  promptLogs    PromptLog[]
  taskNotes     TaskNote[]
}

model Membership {
  id          String @id @default(cuid())
  role        Role
  userId      String
  orgId       String
  notifPrefs  Json?  // { dailyBriefing, weeklyDigest, taskOverdue, portalMessage, isdAlerts }

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
}

// ─── CASE ───────────────────────────────────────────────

model Case {
  id     String     @id @default(cuid())
  orgId  String
  ref    String
  status CaseStatus @default(INTAKE)

  isUrgent             Boolean @default(false)
  hasDeceasedInsurance Boolean @default(false)

  categories TaskCategory[]
  province   String?
  notes      String?

  portalToken   String  @unique @default(cuid())
  portalEnabled Boolean @default(true)

  /// Rotación y revocación del enlace del portal. Antes el token era
  /// permanente: si se filtraba (WhatsApp reenviado, buzón comprometido) no
  /// había forma de invalidarlo sin desactivar el portal entero.
  portalTokenRotatedAt DateTime?
  portalTokenExpiresAt DateTime?
  portalTokenRevokedAt DateTime?

  /// Consentimiento vigente. Se mantienen para compatibilidad y consulta
  /// rápida, pero la EVIDENCIA está en PortalConsent: estos campos por sí
  /// solos no acreditan qué texto se aceptó ni desde dónde.
  consentAccepted  Boolean   @default(false)
  consentDate      DateTime?
  legitimationNote String?

  /// Si en el caudal hay inmueble urbano. Activa la vigilancia del
  /// plazo y la posible no-sujeción de la plusvalía municipal en
  /// el Radar ISD.
  hasUrbanProperty          Boolean @default(false)
  /// Referencia catastral del inmueble principal del caudal (20 caracteres).
  /// El detalle del expediente ofrece deep links a la Sede del Catastro
  /// (consulta ficha y visor cartográfico) cuando está informada.
  referenciaCatastral       String?
  /// Valor declarado en la escritura previa del inmueble urbano.
  /// Junto a propertyTransmissionValue permite detectar la no-sujeción
  /// a IIVTNU tras RDL 26/2021 cuando no hay incremento de valor.
  propertyAcquisitionValue  Float?
  /// Valor declarado en la transmisión mortis causa del inmueble urbano.
  propertyTransmissionValue Float?
  /// Patrimonio preexistente del heredero principal (€). Alimenta la
  /// detección de proximidad a tramos del coeficiente multiplicador
  /// del art. 22 Ley 29/1987.
  preexistingPatrimony      Float?

  /// El causante cambió de residencia fiscal en los 5 años previos al
  /// fallecimiento. Activa el aviso del art. 28 Ley 22/2009 (punto
  /// de conexión por residencia habitual durante los últimos 5 años).
  recentResidenceChange   Boolean @default(false)
  /// Provincia/CCAA de residencia fiscal previa, si la conocemos.
  /// Se usa en el mensaje de la alerta cuando se ha marcado un cambio.
  previousResidenceProvince String?

  /// Reducciones del art. 20 Ley 29/1987 aplicadas en el expediente
  /// y que tienen periodo de mantenimiento (vivienda habitual,
  /// empresa familiar, etc.). Estructura:
  /// [{ "type": "VIVIENDA_HABITUAL", "appliedDate": "2026-04-15",
  ///    "maintenanceYears": 5, "note"?: "..." }, ...]
  /// El Radar ISD las vigila y alerta antes del fin del periodo.
  appliedReductions       Json?

  deletedAt DateTime?
  closedAt  DateTime?

  /// Ciclo de retencion, separado en fases para que "eliminado" signifique algo.
  /// `deletedAt` es solo borrado logico: el expediente sigue en PostgreSQL y
  /// sus documentos en S3.
  purgeScheduledAt DateTime? // cuando toca purgar de verdad
  /// OBSOLETO. La purga BORRA la fila `Case`, así que este campo nunca llega a
  /// leerse con valor: presentarlo como "estado persistente del expediente" era
  /// engañoso. La evidencia de purga vive en `PurgeEvidence`, sin datos
  /// personales. Se conserva la columna para no reescribir historial de
  /// migraciones; no debe usarse.
  purgedAt      DateTime?
  purgeError    String? // ultimo fallo, para reintento
  purgeAttempts Int     @default(0)

  /// Estado explícito del ciclo de purga. Antes sólo había un contador: al
  /// llegar a 5 el expediente dejaba de seleccionarse y sus datos personales
  /// quedaban abandonados en la base y en S3 sin que nadie se enterara.
  purgeState PurgeState @default(PENDING)
  /// Momento a partir del cual se puede volver a intentar. Implementa el
  /// backoff: creciente mientras hay reintentos automáticos, y largo pero
  /// finito una vez que el caso requiere intervención.
  purgeNextAttemptAt DateTime?
  /// Último aviso operativo enviado. Evita repetir el correo en cada pasada.
  purgeAlertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org            Organization      @relation(fields: [orgId], references: [id])
  deceased       Deceased?
  contact        CaseContact?
  tasks          Task[]
  documents      Document[]
  approvals      Approval[]
  promptLogs     PromptLog[]
  auditLogs      AuditLog[]
  notifications  NotificationLog[]
  workflowLogs   WorkflowLog[]
  portalMessages PortalMessage[]
  portalConsents PortalConsent[]

  /// La referencia se generaba con `count + 1` fuera de transacción: dos altas
  /// simultáneas producían la misma. Esta restricción hace que la segunda
  /// falle con P2002 en lugar de duplicar, y el alta reintenta.
  @@unique([orgId, ref])

  /// Lo consulta el cron de retención para localizar lo que toca purgar.
  @@index([purgeScheduledAt])
  @@index([purgeState, purgeNextAttemptAt])
}

model Deceased {
  id        String    @id @default(cuid())
  caseId    String    @unique
  fullName  String
  deathDate DateTime?
  dni       String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseContact {
  id           String  @id @default(cuid())
  caseId       String  @unique
  fullName     String
  phone        String?
  email        String?
  relationship String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// ─── PORTAL CONSENT ─────────────────────────────────────
//
// El consentimiento era un booleano en Case que se sobrescribía en cada
// aceptación. Eso no es evidencia: no acredita QUÉ texto se aceptó, ni cuándo,
// ni desde dónde, y una segunda aceptación borraba la anterior.
//
// Cada aceptación crea una fila nueva e inmutable a nivel de aplicación. Si
// cambia el texto legal, cambia `version` y `textHash`, y se requiere una
// aceptación nueva en lugar de reutilizar la vieja.

model PortalConsent {
  id     String @id @default(cuid())
  caseId String

  /// Versión del texto legal aceptado (p. ej. "2026-08-v1").
  version String
  /// SHA-256 del texto exacto que se mostró. Permite demostrar años después
  /// qué leyó exactamente la persona, sin guardar copias del texto por caso.
  textHash String
  /// Finalidad del consentimiento; hoy sólo el acceso al portal familiar.
  purpose  String @default("PORTAL_FAMILIA")

  /// Nombre que la persona declaró al aceptar.
  declaredName String?
  ip           String?
  userAgent    String?

  acceptedAt DateTime @default(now())
  /// Retirada del consentimiento. Una fila retirada deja de habilitar acceso.
  withdrawnAt DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, acceptedAt])
  @@index([caseId, version])
}

// ─── PORTAL MESSAGE ─────────────────────────────────────

model PortalMessage {
  id         String    @id @default(cuid())
  caseId     String
  fromFamily Boolean
  authorName String?
  content    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

// ─── TASK ───────────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  caseId       String
  category     TaskCategory
  title        String
  description  String?
  status       TaskStatus   @default(PENDING)
  sortOrder    Int          @default(0)
  docTag       String? // tag for document matching
  blockedUntil DateTime? // date-based blocking (e.g., 15 business days)
  deadline     DateTime? // hard deadline (e.g., 6 months ISD)
  blockReason  String? // human-readable reason for block

  dueDate     DateTime?
  assigneeId  String?
  dependsOnId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case       Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee   User?      @relation("AssignedTo", fields: [assigneeId], references: [id])
  dependsOn  Task?      @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependents Task[]     @relation("TaskDependency")
  approval   Approval?
  documents  Document[] @relation("TaskDocuments")
  notes      TaskNote[]
}

// ─── TASK NOTE ──────────────────────────────────────────

model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
}

// ─── DOCUMENT ───────────────────────────────────────────

model Document {
  id             String  @id @default(cuid())
  caseId         String
  taskId         String? // linked task (auto or manual)
  fileName       String
  fileKey        String
  mimeType       String?
  fileSize       Int?
  uploadedBy     String?
  isPortalUpload Boolean @default(false)

  /// Visibilidad en el portal familia. Privado por defecto: antes el portal
  /// devolvía TODOS los documentos del expediente, incluidos los internos, con
  /// URL de descarga prefirmada. Los que sube la propia familia se marcan
  /// visibles al crearse (es su propio documento).
  visibleToFamily Boolean @default(false)

  /// Estado de borrado del objeto en S3. Si el borrado en S3 falla, la fila NO
  /// se elimina y queda marcada aquí para reintento: borrar la referencia
  /// silenciosamente dejaría el fichero huérfano en el bucket para siempre.
  deletionState  String?   // null | PENDING_S3_DELETE | S3_DELETE_FAILED
  deletionError  String?
  deletionAt     DateTime?

  createdAt DateTime @default(now())

  case Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  task Task? @relation("TaskDocuments", fields: [taskId], references: [id])

  @@index([caseId, visibleToFamily])
}

// ─── TEMPLATE ───────────────────────────────────────────

model Template {
  id       String        @id @default(cuid())
  orgId    String
  name     String
  category TaskCategory?
  type     String        @default("email") // email | carta | solicitud

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization      @relation(fields: [orgId], references: [id])
  versions TemplateVersion[]
}

model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  version    Int      @default(1)
  subject    String?
  body       String
  variables  String[] // e.g. ["deceased.fullName", "contact.fullName"]
  isApproved Boolean  @default(false)

  createdAt DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// ─── AUTOPILOT / IA ─────────────────────────────────────

model PromptLog {
  id     String  @id @default(cuid())
  caseId String?
  userId String
  action String // "generate_checklist" | "generate_draft" | etc

  /// El prompt integro YA NO se guarda: contenia el contexto del expediente
  /// con nombres, DNI, telefonos y emails, duplicando la PII y conservandola
  /// sin plazo. Se guarda su huella para poder correlacionar una respuesta
  /// con su entrada sin almacenarla.
  contextHash String?
  /// Respuesta ya minimizada (sin identificadores directos).
  response    String
  model       String?
  tokens      Int?

  createdAt DateTime @default(now())

  case Case? @relation(fields: [caseId], references: [id])
  user User  @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model Approval {
  id         String         @id @default(cuid())
  caseId     String
  taskId     String?        @unique
  action     String // "send_email" | "mark_sent" | etc
  status     ApprovalStatus @default(PENDING)
  details    String?
  reviewerId String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  case     Case  @relation(fields: [caseId], references: [id])
  task     Task? @relation(fields: [taskId], references: [id])
  reviewer User? @relation(fields: [reviewerId], references: [id])
}

// ─── AUDIT ──────────────────────────────────────────────

model AuditLog {
  id      String  @id @default(cuid())
  orgId   String
  userId  String?
  caseId  String?
  action  String
  details String?
  ip      String?

  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id])
  user User?        @relation(fields: [userId], references: [id])
  case Case?        @relation(fields: [caseId], references: [id])
}

// ─── BILLING ────────────────────────────────────────────

model Subscription {
  id               String          @id @default(cuid())
  orgId            String          @unique
  stripeCustomerId String?
  stripeSubId      String?
  plan             PlanTier        @default(INICIA)
  interval         BillingInterval @default(MONTHLY)
  status           String          @default("active") // active | past_due | canceled
  currentPeriodEnd DateTime?

  // Setup fee (one-time, required for DESPACHO/FIRMA onboarding)
  setupFeePaid   Boolean   @default(false)
  setupFeePaidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id])
}

/// Fases del ciclo de purga. La auditoría exigía distinguirlas: con un simple
/// contador de intentos, "pendiente", "fallando" y "abandonado" eran el mismo
/// estado a ojos de cualquiera que mirase la base de datos.
enum PurgeState {
  /// Programado, aún no intentado.
  PENDING
  /// Un proceso lo tiene reclamado ahora mismo.
  PROCESSING
  /// Falló y se reintenta solo, con backoff creciente.
  RETRYABLE_FAILURE
  /// Agotados los reintentos automáticos rápidos. Sigue reintentándose con
  /// backoff largo, pero ya ha generado aviso operativo y admite reintento
  /// manual: los datos personales NO se abandonan.
  NEEDS_INTERVENTION
  /// Sólo por completitud del enum: al completarse, la fila `Case` se elimina
  /// y la constancia queda en `PurgeEvidence`.
  COMPLETED
}

/// Evidencia de purga SIN datos personales.
///
/// La purga borra la fila `Case` entera, así que no puede quedar constancia en
/// ella (`Case.purgedAt` nunca llegaba a observarse). Esta tabla conserva lo
/// necesario para demostrar el cumplimiento —qué organización, qué referencia
/// interna, cuándo, cuántos objetos se borraron— y nada más: ni nombre del
/// causante, ni contacto, ni ningún identificador de persona.
model PurgeEvidence {
  id    String @id @default(cuid())
  orgId String
  /// Referencia interna del expediente (p. ej. `EXP-2026-0042`). No es un dato
  /// personal: es un correlativo por organización.
  caseRef String

  scheduledAt      DateTime?
  purgedAt         DateTime  @default(now())
  documentsDeleted Int       @default(0)
  attempts         Int       @default(0)

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, purgedAt])
}

/// Contador numérico de referencias de expediente, por organización y año.
///
/// Antes la siguiente referencia se deducía de `ORDER BY ref DESC`, es decir de
/// una comparación de CADENAS. Con menos de 10.000 expedientes al año el
/// relleno a cuatro dígitos hacía que el orden lexicográfico coincidiera con el
/// numérico, así que funcionaba por accidente. En cuanto se supera esa cifra,
/// `EXP-2026-10000` es lexicográficamente MENOR que `EXP-2026-9999`: el máximo
/// leído sería 9999, la siguiente referencia calculada 10000 — ya existente— y
/// el alta fallaría en bucle con P2002 hasta agotar los reintentos.
model CaseCounter {
  orgId String
  year  Int
  /// Última referencia asignada. Se incrementa de forma atómica.
  lastNumber Int @default(0)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, year])
}

model UsageRecord {
  id           String @id @default(cuid())
  orgId        String
  month        String // "2026-04"
  casesCreated Int    @default(0)

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, month])
}

// ─── NOTIFICATIONS ──────────────────────────────────────

enum NotificationKind {
  ISD_60D
  ISD_30D
  ISD_7D
  ISD_1D
  ISD_PASSED
  FAMILY_PENDING_DOCS
}

enum NotificationChannel {
  EMAIL_INTERNAL
  EMAIL_FAMILY
  SLACK
  TEAMS
  WEBHOOK
}

/// Estado de una ENTREGA concreta (expediente, tipo, canal, destinatario,
/// ventana). Antes no existía: se consultaba si había una entrega correcta, se
/// enviaba, y sólo después se registraba. Dos ejecuciones simultáneas del cron
/// leían ambas "no enviado" y ambas enviaban.
enum NotificationDeliveryStatus {
  /// Reservada pero aún no intentada.
  PENDING
  /// Reclamada por un proceso, que está llamando al proveedor externo.
  PROCESSING
  /// Confirmada por el proveedor.
  SENT
  /// Falló. Es reintentable.
  FAILED
}

model NotificationLog {
  id        String              @id @default(cuid())
  orgId     String
  caseId    String
  kind      NotificationKind
  channel   NotificationChannel
  recipient String // email
  status    String              @default("sent") // sent | failed
  error     String?

  /// Clave de deduplicación por ENTREGA:
  /// `<caseId>:<kind>:<channel>:<recipient>:<ventana>`.
  ///
  /// Antes la deduplicación era por (expediente, tipo): si un destinatario
  /// recibía el email y otro fallaba, la siguiente ejecución saltaba el
  /// expediente entero y el segundo no lo recibía nunca. Y un email enviado
  /// bloqueaba también Slack, Teams y el webhook.
  ///
  /// Sólo se rellena en los envíos correctos, así que un fallo se puede
  /// reintentar de forma independiente. Nullable por las filas anteriores.
  dedupeKey String? @unique

  /// Estado de la máquina de entrega. La fila se crea en PROCESSING ANTES de
  /// llamar al proveedor externo: quien consigue crearla (o reclamarla con una
  /// actualización condicional) es el único que envía.
  deliveryStatus NotificationDeliveryStatus @default(SENT)
  attempts       Int                        @default(0)
  /// Momento en que se reclamó. Sirve para detectar entregas colgadas.
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id])
  case Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, kind])
  @@index([orgId, createdAt])
  @@index([caseId, kind, channel, recipient])
  @@index([deliveryStatus, startedAt])
}

// ─── CASE TASK TEMPLATES ────────────────────────────────

model CaseTemplate {
  id          String         @id @default(cuid())
  orgId       String
  name        String
  description String?
  categories  TaskCategory[]
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  org   Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tasks CaseTemplateTask[]

  @@index([orgId])
}

model CaseTemplateTask {
  id                 String       @id @default(cuid())
  templateId         String
  category           TaskCategory
  title              String
  description        String?
  deadlineOffsetDays Int?
  sortOrder          Int          @default(0)

  template CaseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

// ─── WORKFLOW AUTOMATION ────────────────────────────────

enum WorkflowTrigger {
  CASE_STATUS_CHANGED
  TASK_STATUS_CHANGED
  CASE_CREATED
  DOCUMENT_UPLOADED
}

enum WorkflowAction {
  SEND_EMAIL_CONTACT
  SEND_EMAIL_TEAM
  ADD_CASE_COMMENT
  CHANGE_CASE_STATUS
}

enum WorkflowLogStatus {
  SUCCESS
  /// Parte de los destinatarios recibió el envío y parte no. Antes este estado
  /// no existía: bastaba con que UNO de diez destinatarios funcionara para que
  /// la ejecución se registrase como SUCCESS, y los nueve fallos quedaban
  /// invisibles y sin reintento.
  PARTIAL
  FAILED
  SKIPPED
}

/// Estado de la entrega a UN destinatario concreto de una ejecución de workflow.
enum WorkflowDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model WorkflowRule {
  id           String          @id @default(cuid())
  orgId        String
  name         String
  description  String?
  isActive     Boolean         @default(true)
  trigger      WorkflowTrigger
  conditions   Json
  action       WorkflowAction
  actionConfig Json
  execCount    Int             @default(0)
  lastRunAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  org  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  logs WorkflowLog[]

  @@index([orgId, isActive])
}

model WorkflowLog {
  id        String            @id @default(cuid())
  ruleId    String
  caseId    String?
  status    WorkflowLogStatus
  details   Json?
  error     String?
  createdAt DateTime          @default(now())

  rule       WorkflowRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  case       Case?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  deliveries WorkflowDelivery[]

  @@index([ruleId, createdAt])
  @@index([caseId])
}

/// Entrega individual a un destinatario.
///
/// Sin esto, el resultado de una acción con varios destinatarios era un único
/// booleano: no se sabía QUIÉN no lo había recibido ni se podía reintentar sólo
/// con esos, porque reintentar la regla entera habría duplicado el envío a los
/// que sí lo recibieron.
model WorkflowDelivery {
  id            String                 @id @default(cuid())
  workflowLogId String
  /// Email del destinatario interno.
  recipient  String
  status     WorkflowDeliveryStatus @default(PENDING)
  error      String?
  attempts   Int                    @default(0)
  lastTriedAt DateTime?
  sentAt     DateTime?
  createdAt  DateTime               @default(now())

  log WorkflowLog @relation(fields: [workflowLogId], references: [id], onDelete: Cascade)

  @@unique([workflowLogId, recipient])
  @@index([status, lastTriedAt])
}

// ─── DEMO REQUEST ───────────────────────────────────────

model DemoRequest {
  id      String  @id @default(cuid())
  orgId   String?
  name    String
  email   String
  company String?
  phone   String?
  message String?

  // Attribution: where the prospect came from. E.g. "landing_hero",
  // "demo_banner" (clicked from inside the live demo), "demo_dashboard",
  // "pricing". Null for legacy rows.
  source String?

  // Mini-CRM pipeline. NEW → CONTACTED → MEETING → PILOT → CUSTOMER | LOST
  leadStatus    String  @default("NEW")
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization? @relation(fields: [orgId], references: [id])
}

// ─── STRIPE WEBHOOK IDEMPOTENCY ─────────────────────────
// Stripe reintenta cada evento hasta 3 dias si el endpoint no responde 200
// rapido. Cacheamos el event.id para no duplicar emails ni mutaciones de
// suscripcion en reintentos.

enum StripeEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  /// Agotados los reintentos automáticos. Ya no se reintenta solo: requiere que
  /// alguien mire qué pasa. Se distingue de FAILED para que un evento atascado
  /// no quede indistinguible de uno que aún va a recuperarse por sí mismo.
  NEEDS_INTERVENTION
}

model StripeEvent {
  id   String @id // Stripe event.id (evt_xxx)
  type String

  /// Antes sólo existía `processedAt`, escrito ANTES de ejecutar la lógica: si
  /// el handler fallaba, el evento quedaba marcado y el reintento de Stripe se
  /// descartaba como duplicado. La mutación de suscripción se perdía para
  /// siempre — un cobro cobrado y no aplicado.
  ///
  /// Ahora sólo PROCESSED descarta un reintento. FAILED y PROCESSING caducado
  /// vuelven a intentarse.
  status StripeEventStatus @default(RECEIVED)

  attempts  Int       @default(0)
  lastError String?
  /// Momento en que se tomó el evento para procesarlo. Sirve para detectar
  /// ejecuciones colgadas (proceso muerto a mitad).
  startedAt   DateTime?
  receivedAt  DateTime  @default(now())
  completedAt DateTime?

  /// Momento del último aviso operativo enviado por este evento. Evita repetir
  /// el mismo correo en cada pasada del cron de recuperación.
  alertedAt DateTime?

  @@index([status, receivedAt])
  @@index([receivedAt])
  @@index([status, startedAt])
}
